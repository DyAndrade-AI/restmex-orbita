---
import BaseLayout from "../layouts/BaseLayout.astro";
import m from "../data/metrics.json";

const pct = (v: number, d = 0) => `${(v * 100).toFixed(d)}%`;
const su = m.simulated_users;
const roles = Object.entries(m.role_sensitivity.role_unchanged_pct);
// Capítulos = inicio real de cada escena en la línea de tiempo de la narración (segundos).
const chapters: [number, string][] = [
  [0, "¿Por qué Órbita?"], [16.8, "La base: 208 mil reseñas"], [39.4, "Átomos de gusto"],
  [71.8, "Simular el olvido"], [98, "Los 5 futuros"], [142.3, "Tú eliges el riesgo"],
  [162.3, "Contrafactuales"], [188.3, "Fragilidad honesta"], [207.7, "Strange Loop"],
  [231.2, "50,000 versiones de ti"], [252.6, "La pregunta de sacrificio"], [277.8, "Entropía"],
  [291.1, "Tres niveles de evaluación"], [357.2, "Auditoría"], [385, "Innovación y riesgos"],
  [411.1, "Cierre"],
];
const stressLabels: Record<string, string> = {
  prior: "Mismos supuestos del modelo",
  concentrada: "Gustos dominados por una preferencia",
  "relevancia_0.50": "Otra ponderación del ranking",
  rendimientos_decrecientes: "Rendimientos decrecientes",
  ruido_15: "15 % de respuestas erróneas",
  ruido_30: "30 % de respuestas erróneas",
};
const clock = (t: number) => `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, "0")}`;
---

<BaseLayout
  title="Órbita — explora posibilidades, no solo destinos"
  description="Sistema de inteligencia artificial sobre 208,051 reseñas de 40 Pueblos Mágicos: ranking 5 + 5, cinco perspectivas con roles distintos y exploración de 50,000 escenarios de preferencias."
>
  <a class="skip-link" href="#recomendar">Saltar al recomendador</a>
  <header class="site-header">
    <a class="brand" href="#top" aria-label="Órbita, inicio">
      <span class="brand-mark"><i></i></span>
      <span>ÓRBITA</span>
    </a>
    <nav aria-label="Navegación principal">
      <a href="#recomendar">Recomendar</a>
      <a href="#orbita">Órbita</a>
      <a href="#strange-loop">Strange Loop</a>
      <a href="#resultados">Resultados</a>
      <a href="#califica" class="nav-cta">Evaluar</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero shell">
      <div class="hero-copy">
        <p class="eyebrow">INTELIGENCIA ARTIFICIAL · TURISMO · REST-MEX 2025</p>
        <h1>No explores solo destinos.<br /><em>Explora posibilidades.</em></h1>
        <p class="hero-lede">
          Un sistema de inteligencia artificial que analiza experiencias turísticas reales, interpreta
          tus preferencias y explora cómo diferentes prioridades pueden transformar tus recomendaciones.
        </p>
        <div class="hero-actions">
          <a class="hero-play" href="#recomendar"><span aria-hidden="true">↗</span> Explorar destinos</a>
          <a class="text-link" href="#orbita">Descubrir Órbita <span aria-hidden="true">↓</span></a>
        </div>
        <dl class="hero-stats">
          <div><dt>Pueblos Mágicos</dt><dd>{m.corpus.towns}</dd></div>
          <div><dt>Reseñas en el corpus</dt><dd>{m.corpus.reviews.toLocaleString("es-MX")}</dd></div>
          <div><dt>Hit@5 · reseñas ocultas</dt><dd>{pct(m.holdout.hit_at_5, 1)}</dd></div>
          <div><dt>Escenarios por consulta</dt><dd>50,000</dd></div>
        </dl>
        <p class="hero-footnote">Hit@5: el pueblo correcto aparece entre los 5 primeros en {m.holdout.reviews} reseñas reservadas usadas como consultas (azar: {pct(m.holdout.random_hit_at_5, 1)}).</p>
      </div>

      <div class="orbit-visual" role="img" aria-label="Diagrama: tu consulta en el centro y cinco destinos con roles distintos orbitando alrededor">
        <div class="portal-gate" aria-hidden="true">
          <div class="portal-ring ring-a"></div>
          <div class="portal-ring ring-b"></div>
          <div class="portal-ring ring-c"></div>
          <div class="portal-sparks" id="hero-sparks"></div>
        </div>
        <div class="orbit orbit-one" aria-hidden="true"><span class="planet p-one" data-orbit-label="Ancla"></span><span class="planet p-four" data-orbit-label="Superviviente"></span></div>
        <div class="orbit orbit-two" aria-hidden="true"><span class="planet p-two" data-orbit-label="Portal"></span></div>
        <div class="orbit orbit-three" aria-hidden="true"><span class="planet p-three" data-orbit-label="Comodín"></span><span class="planet p-five" data-orbit-label="Especialista"></span></div>
        <div class="core" aria-hidden="true">
          <span>TU</span>
          <strong>CONSULTA</strong>
        </div>
        <div class="coordinate coord-a" aria-hidden="true">5 ROLES</div>
        <div class="coordinate coord-b" aria-hidden="true">40 DESTINOS</div>
      </div>
    </section>

    <section class="lab-section classic-section" id="recomendar">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">01 · RECOMENDACIÓN</p>
            <h2>Describe tu viaje. Te mostramos los más afines.</h2>
          </div>
          <p>Ordenamos los 40 pueblos por afinidad con tu descripción y respaldamos cada resultado con reseñas reales.</p>
        </div>
        <form class="query-console" id="classic-form">
          <div class="console-bar"><span><i></i> RANKING 5 + 5</span><span id="classic-status" role="status">LISTO</span></div>
          <label for="classic-query">¿Qué experiencia estás buscando?</label>
          <textarea id="classic-query" name="classic-query" rows="2" required minlength="8"
            placeholder="Quiero cenotes para nadar y comida yucateca, sin Tulum…">Quiero cenotes para nadar y comida yucateca, sin Tulum</textarea>
          <div class="console-controls classic-controls">
            <button class="submit-button" type="submit"><span>Recomendar</span><b aria-hidden="true">↗</b></button>
          </div>
          <div class="examples" aria-label="Consultas de ejemplo">
            <span>Prueba:</span>
            <button type="button" data-classic="Playas tranquilas, agua turquesa y snorkel">Playa</button>
            <button type="button" data-classic="Busco pirámides, arqueología e historia prehispánica">Arqueología</button>
            <button type="button" data-classic="Naturaleza y aventura en la sierra, sin playa ni mar">Sierra sin mar</button>
            <button type="button" data-classic="Quiero vino, viñedos y recorridos por bodegas">Vino</button>
          </div>
        </form>
        <div class="classic-results" id="classic-results" aria-live="polite"></div>
      </div>
    </section>

    <section class="lab-section orbit-section" id="orbita">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">02 · ÓRBITA</p>
            <h2>Una intención. Cinco perspectivas.</h2>
          </div>
          <p>Órbita explora alternativas con fortalezas distintas para que veas cómo cambian las recomendaciones cuando cambian tus prioridades.</p>
        </div>

        <ul class="role-legend" aria-label="Los cinco roles de Órbita">
          <li data-role="Ancla"><i aria-hidden="true">◎</i><b>Ancla</b><span>La coincidencia más directa con tu consulta.</span></li>
          <li data-role="Superviviente"><i aria-hidden="true">◆</i><b>Superviviente</b><span>Resiste aunque una prioridad desaparezca.</span></li>
          <li data-role="Portal"><i aria-hidden="true">◐</i><b>Portal</b><span>Novedosa, sin romper tu intención.</span></li>
          <li data-role="Especialista"><i aria-hidden="true">▲</i><b>Especialista</b><span>Destaca en una preferencia concreta.</span></li>
          <li data-role="Comodín"><i aria-hidden="true">✦</i><b>Comodín</b><span>Equilibra afinidad, estabilidad y sorpresa.</span></li>
        </ul>

        <form class="query-console" id="query-form">
          <div class="console-bar">
            <span><i></i> ÓRBITA + STRANGE LOOP</span>
            <span id="api-status" role="status">CONECTANDO AL MOTOR…</span>
          </div>
          <label for="query">Describe tu viaje ideal</label>
          <textarea id="query" name="query" rows="3" required minlength="8"
            placeholder="Quiero bosque, cabañas, comida tradicional y aventura, sin playa…">Quiero bosque, cabañas, gastronomía y aventura, sin playa</textarea>
          <div class="console-controls">
            <div class="risk-control">
              <div class="risk-labels">
                <label for="risk">Riesgo creativo</label>
                <output id="risk-output" for="risk">55%</output>
              </div>
              <input id="risk" name="risk" type="range" min="0" max="100" value="55" aria-describedby="risk-help" />
              <div class="risk-scale"><span>PRECISO</span><span>INESPERADO</span></div>
              <p class="risk-help" id="risk-help">Más riesgo = el Portal se aleja más del Ancla y los escenarios exploran prioridades más extremas.</p>
            </div>
            <button class="submit-button" type="submit">
              <span>Explorar perspectivas</span><b aria-hidden="true">↗</b>
            </button>
          </div>
          <div class="examples" aria-label="Consultas de ejemplo">
            <span>Prueba:</span>
            <button type="button" data-query="Quiero cascadas, vegetación y aventura al aire libre">Cascadas y aventura</button>
            <button type="button" data-query="Quiero arquitectura colonial, gastronomía tradicional y actividades culturales, pero sin playa">Colonial sin playa</button>
            <button type="button" data-query="Desierto, silencio y paisajes naturales, sin playa">Desierto</button>
          </div>
        </form>

        <div class="loading-panel" id="loading" hidden role="status">
          <div class="loader-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
          <p>Analizando tu intención y explorando 50,000 escenarios…</p>
          <span>Cada escenario es una forma distinta de priorizar tus preferencias</span>
        </div>

        <div class="error-panel" id="error" hidden role="alert">
          <strong id="error-title">No pudimos completar la exploración.</strong>
          <p id="error-message"></p>
        </div>

        <div class="orbit-results" id="orbit-results" hidden>
          <div class="atoms-panel">
            <div>
              <p class="eyebrow">ÁTOMOS DE GUSTO</p>
              <p class="atoms-help">Cada átomo representa una preferencia que podemos explorar por separado.</p>
            </div>
            <div class="atoms" id="orbit-atoms"></div>
          </div>
          <p class="orbit-note" id="orbit-note" hidden></p>
          <div class="orbit-grid" id="orbit-grid"></div>
          <details class="soft-details">
            <summary>¿Por qué las alternativas con menor afinidad quedan abajo?</summary>
            <ul class="bottom-orbit" id="bottom-orbit"></ul>
            <p class="fine">“Igualar al Ancla” se calcula en la utilidad de facetas U = 0.16·r + 0.84·w·M, no en el ranking completo de 40.</p>
          </details>
        </div>
      </div>
    </section>

    <section class="lab-section loop-section" id="strange-loop">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">03 · STRANGE LOOP</p>
            <h2>Explora miles de posibilidades.</h2>
          </div>
          <p>Strange Loop prueba muchas maneras de repartir tus prioridades y descubre qué destinos destacan en cada escenario. Tus respuestas cierran los escenarios que no encajan contigo.</p>
        </div>

        <ol class="loop-steps" aria-label="Cómo funciona Strange Loop">
          <li><span>01</span><b>Reconoce</b> tus preferencias.</li>
          <li><span>02</span><b>Simula</b> 50,000 formas de priorizarlas.</li>
          <li><span>03</span><b>Pregunta</b> qué conservarías.</li>
          <li><span>04</span><b>Descarta</b> los escenarios incompatibles.</li>
        </ol>

        <div class="loop-empty" id="loop-empty">
          <p>Describe tu viaje en Órbita y aquí aparecerá tu multiverso de escenarios.</p>
          <a class="text-link" href="#orbita">Ir a Órbita <span aria-hidden="true">↑</span></a>
        </div>

        <div class="results multiverse-results" id="results" hidden>
          <div class="multiverse-head">
            <div>
              <p class="eyebrow">TU MULTIVERSO</p>
              <h3 class="loop-title">¿Qué destino destaca en más escenarios?</h3>
            </div>
            <button class="reset-loop" id="reset-loop" type="button">↺ Reiniciar decisiones</button>
          </div>

          <div class="multiverse-stats" aria-live="polite">
            <div><strong id="total-futures">0</strong><span>escenarios explorados</span></div>
            <div><strong id="surviving-futures">0</strong><span>compatibles con tus decisiones</span></div>
            <div><strong id="top-destination" class="stat-text">—</strong><span>destino más frecuente</span></div>
            <div><strong id="change-value" class="stat-text">—</strong><span>cambio tras responder</span></div>
          </div>

          <div class="facet-row multiverse-facets" id="facets" aria-label="Peso medio de cada preferencia en los escenarios compatibles"></div>

          <div class="multiverse-chamber" id="multiverse-chamber">
            <canvas id="multiverse-canvas" role="img" aria-label="Visualización: escenarios fluyendo hacia los destinos que ganan en ellos"></canvas>
            <div class="canvas-overlay">
              <span>MAPA DE ESCENARIOS</span>
              <b id="particle-caption">Cada luz es una forma posible de priorizar tus gustos</b>
            </div>
            <div class="portal-legend" id="portal-legend"></div>
            <div class="collapse-flash" id="collapse-flash"></div>
          </div>

          <section class="sacrifice-console" id="sacrifice-console" aria-labelledby="sacrifice-question">
            <div class="sacrifice-symbol" aria-hidden="true">
              <span></span><i></i><b></b>
            </div>
            <div class="sacrifice-content">
              <p class="eyebrow">TU DECISIÓN</p>
              <h3 id="sacrifice-question">Calculando la pregunta más útil…</h3>
              <div class="sacrifice-actions" id="sacrifice-actions"></div>
              <div class="decision-trail" id="decision-trail"></div>
            </div>
          </section>

          <div class="basin-heading">
            <div><p class="eyebrow">DESTINOS QUE DESTACAN</p><h3>Dónde terminan tus escenarios</h3></div>
            <p>El porcentaje es la fracción de escenarios simulados en que cada destino resulta el mejor. Es una frecuencia de simulación, no una probabilidad de que el viaje te guste.</p>
          </div>
          <div class="basin-grid" id="basin-grid"></div>

          <section class="shift-panel" id="shift-panel" hidden aria-labelledby="shift-title">
            <h3 id="shift-title">Antes y después de tu decisión</h3>
            <ol class="shift-list" id="shift-list"></ol>
          </section>

          <details class="math-panel">
            <summary>Explorar matemáticas y metodología</summary>
            <div class="math-grid">
              <div><strong id="entropy-value">0</strong><span>entropía de decisión (0 = un solo destino, 100 = todos igual de frecuentes)</span></div>
              <div><strong id="collapsed-futures">0</strong><span>escenarios descartados por tus respuestas</span></div>
            </div>
            <p id="information-gain"></p>
            <p class="simulation-disclaimer" id="mc-note"></p>
            <ul class="formula-list">
              <li><b>Preferencias:</b> w ~ Dirichlet(α·1), α = (28 − 24ρ)/K, con ρ = riesgo creativo.</li>
              <li><b>Utilidad:</b> U(d) = 0.16·r(d) + 0.84·Σ w<sub>f</sub>·M[f,d] + ε, con ε ~ Gumbel. Los destinos que incumplen una exclusión quedan descartados.</li>
              <li><b>Pregunta:</b> se elige la de mayor ganancia de información, IG = H(antes) − Σ (n<sub>b</sub>/n)·H(rama).</li>
              <li><b>Respuesta:</b> conserva exactamente los escenarios con w<sub>conservar</sub> ≥ w<sub>sacrificar</sub>.</li>
            </ul>
            <h4>Alternativas con menor afinidad dentro del multiverso</h4>
            <ul class="bottom-orbit" id="bottom-multiverse"></ul>
          </details>

          <section class="trajectory-panel">
            <div class="trajectory-copy">
              <p class="eyebrow">EXPLORACIÓN ESPECULATIVA</p>
              <h3>Un viaje puede inspirar el siguiente.</h3>
              <p>Simulación exploratoria de cómo un destino podría reforzar ciertas preferencias para la próxima elección. No es una predicción.</p>
            </div>
            <div class="trajectory-line" id="trajectory-line"></div>
          </section>

          <p class="simulation-disclaimer" id="simulation-disclaimer"></p>
        </div>
        <div class="error-panel" id="loop-error" hidden role="alert">
          <strong>Strange Loop no pudo abrir el multiverso.</strong>
          <p id="loop-error-message"></p>
        </div>
      </div>
    </section>

    <section class="eval-section" id="resultados">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">04 · EVIDENCIA</p>
            <h2>Resultados respaldados por experimentación.</h2>
          </div>
          <p>Cada cifra se genera desde los artefactos experimentales del repositorio, con su muestra y su tipo de evaluación.</p>
        </div>

        <div class="proof-grid">
          <article class="proof">
            <span class="proof-kind">Recuperación de información · prueba autosupervisada</span>
            <strong class="proof-big">{pct(m.holdout.hit_at_5, 1)}</strong>
            <h3>Hit@5</h3>
            <p>Recuperación del pueblo correcto entre los primeros cinco, usando {m.holdout.reviews} reseñas reservadas como consultas, sin que el índice las haya visto.</p>
            <ul class="hbars" aria-label="Hit@5 comparado con referencias">
              <li style={`--v:${m.holdout.hit_at_5}`}><span>Órbita</span><i></i><b>{pct(m.holdout.hit_at_5, 1)}</b></li>
              <li class="muted" style={`--v:${m.holdout.popularity_hit_at_5}`}><span>Popularidad</span><i></i><b>{pct(m.holdout.popularity_hit_at_5, 1)}</b></li>
              <li class="muted" style={`--v:${m.holdout.random_hit_at_5}`}><span>Azar</span><i></i><b>{pct(m.holdout.random_hit_at_5, 1)}</b></li>
            </ul>
            <p class="proof-meta">Hit@1 {pct(m.holdout.hit_at_1, 1)} · MRR {m.holdout.mrr.toFixed(3)} · el pueblo correcto cae en el Bottom 5 solo {pct(m.holdout.bottom_error_rate, 1)} de las veces (azar: 12.5%).</p>
          </article>

          <article class="proof">
            <span class="proof-kind">Exploración de preferencias · usuarios simulados</span>
            <strong class="proof-big">{pct(su.loop_hit_at_1[3], 1)}</strong>
            <h3>Destino ideal encontrado tras 3 preguntas</h3>
            <p>Evaluación con usuarios simulados bajo los supuestos del modelo, en {su.queries} consultas con dos o más preferencias.</p>
            <ol class="steps-chart" aria-label="Acierto del destino ideal según el número de preguntas">
              <li style={`--v:${su.anchor_hit_at_1}`}><b>{pct(su.anchor_hit_at_1, 1)}</b><span>Ancla</span></li>
              {su.loop_hit_at_1.map((v, i) => <li class="hot" style={`--v:${v}`}><b>{pct(v, 1)}</b><span>{i === 0 ? "Sin preg." : `${i} preg.`}</span></li>)}
            </ol>
            <p class="proof-meta">Con 1 pregunta, la pregunta informativa supera a una al azar por {(su.gain_1q.informativa_menos_azar * 100).toFixed(1)} pp (IC95 [{(su.gain_1q.ci95[0] * 100).toFixed(1)}, {(su.gain_1q.ci95[1] * 100).toFixed(1)}]). Con 3 preguntas ambas prácticamente empatan.</p>
          </article>

          <article class="proof">
            <span class="proof-kind">Robustez y reproducibilidad</span>
            <strong class="proof-big">{m.role_sensitivity.portfolio_jaccard_mean.toFixed(2)}</strong>
            <h3>Similitud de Jaccard de la cartera</h3>
            <p>Mide cuánto se parecen los cinco destinos de Órbita (1 = idénticos) cuando todos sus pesos de diseño se perturban ±{pct(m.role_sensitivity.spread)} a la vez.</p>
            <ul class="checks">
              <li><b>{m.tests}</b> pruebas automáticas aprobadas</li>
              <li><b>{m.monte_carlo.max_diff_pp_at_50k.toFixed(2)} pp</b> diferencia máxima con 50,000 escenarios frente a 200,000</li>
              <li><b>{pct(m.monte_carlo.seed_agreement_min)}</b> de las semillas auditadas coinciden en el destino líder (peor consulta)</li>
              <li><b>{m.orbit_audit.all_contracts_pass ? "✓" : "✗"}</b> cinco perspectivas distintas y reproducibles en {m.orbit_audit.queries} consultas</li>
            </ul>
          </article>
        </div>

        <details class="method-details">
          <summary>Metodología y alcance de los resultados</summary>
          <div class="method-grid">
            <section>
              <h3>Tipos de evidencia</h3>
              <ul class="evidence-types">
                <li><b>Prueba autosupervisada</b> · {m.holdout.reviews} reseñas reservadas como consultas, con el nombre del pueblo oculto. Es la medida principal de relevancia.</li>
                <li><b>Conjunto heurístico</b> · {m.gold.queries} consultas escritas por el equipo: Hit@1 {pct(m.gold.hit_at_1, 1)}, nDCG@5 {m.gold.ndcg_at_5.toFixed(3)}. La Precision@5 de {pct(m.gold.precision_at_5, 1)} se calcula solo en las {m.gold.wide_queries} consultas con al menos 5 destinos aceptables. Se usa como prueba de regresión: sus autores conocían el sistema.</li>
                <li><b>Usuarios simulados</b> · gustos ocultos y respuestas automáticas. Miden coherencia interna y eficiencia de las preguntas, no satisfacción de personas.</li>
                <li><b>Evaluación humana</b> · laboratorio ciego en curso (sección 05). Aún no hay juicios suficientes para reportar métricas humanas.</li>
              </ul>
            </section>
            <section>
              <h3>Supuestos puestos a prueba</h3>
              <p>Cada población rompe un supuesto del modelo. Mejora con 3 preguntas frente a ninguna (IC95 bootstrap sobre consultas):</p>
              <table class="stress-table">
                <thead><tr><th scope="col">Población simulada</th><th scope="col">Acierto, 3 preg.</th><th scope="col">Mejora (IC95)</th></tr></thead>
                <tbody>
                  {Object.entries(m.stress).map(([name, row]: [string, any]) => (
                    <tr class={row.gain_3q.ci95_mejora[0] <= 0 ? "inconclusive" : ""}>
                      <th scope="row">{stressLabels[name] ?? name}</th>
                      <td>{pct(row.loop_hit_at_1[3], 1)}</td>
                      <td>{(row.gain_3q.mejora_vs_sin_preguntas * 100).toFixed(1)} pp [{(row.gain_3q.ci95_mejora[0] * 100).toFixed(1)}, {(row.gain_3q.ci95_mejora[1] * 100).toFixed(1)}]</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="fine">Filas atenuadas: el intervalo incluye 0, la mejora no es concluyente bajo ese supuesto.</p>
            </section>
            <section>
              <h3>Sensibilidad de los roles</h3>
              <p>Frecuencia con que cada rol conserva su destino al perturbar los pesos de diseño ±{pct(m.role_sensitivity.spread)}:</p>
              <ul class="role-bars">
                {roles.map(([role, v]) => <li><span>{role}</span><i style={`--v:${(v as number) / 100}`}></i><b>{(v as number).toFixed(0)}%</b></li>)}
              </ul>
              <p class="fine">Los pesos de los roles y del modelo de escenarios son de diseño: su sensibilidad está medida, pero su valor óptimo requiere evaluación humana.</p>
            </section>
          </div>
          <details class="eval-live">
            <summary>Ejecutar la evaluación automática en vivo</summary>
            <div class="eval-panel" id="eval-panel">
              <div class="eval-actions">
                <button type="button" class="submit-button" id="eval-run"><span>Ejecutar evaluación</span><b aria-hidden="true">▶</b></button>
                <button type="button" class="ghost-button" id="eval-last">Ver último reporte completo</button>
              </div>
              <div id="eval-output" aria-live="polite"></div>
            </div>
          </details>
        </details>
      </div>
    </section>

    <section class="video-section" id="video">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">EN 2 MINUTOS</p>
            <h2>Cómo funciona Órbita.</h2>
          </div>
          <p>Para todo público. Para el detalle técnico, cambia a la versión de 7 minutos con capítulos.</p>
        </div>
        <div class="video-tabs" role="tablist" aria-label="Versión del video">
          <button type="button" role="tab" aria-selected="true" data-src="/media/orbita-2min.mp4" data-poster="/media/orbita-2min-poster.jpg">2 min · para todos</button>
          <button type="button" role="tab" aria-selected="false" data-src="/media/orbita.mp4" data-poster="/media/orbita-poster.jpg">7 min · técnica, con capítulos</button>
        </div>
        <div class="video-layout short" id="video-layout">
          <div class="video-frame">
            <video id="explainer" controls preload="metadata" playsinline poster="/media/orbita-2min-poster.jpg"
              aria-label="Video explicativo de Órbita, con subtítulos integrados">
              <source src="/media/orbita-2min.mp4" type="video/mp4" />
              Tu navegador no reproduce video. <a href="/media/orbita-2min.mp4">Descárgalo aquí</a>.
            </video>
          </div>
          <ol class="chapters" id="chapters" aria-label="Capítulos de la versión técnica">
            {chapters.map(([t, title], i) => (
              <li><button type="button" data-t={t} data-end={chapters[i + 1]?.[0] ?? 1e9}><span>{clock(t)}</span>{title}</button></li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="califica-section" id="califica">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">05 · LABORATORIO DE EVALUACIÓN HUMANA</p>
            <h2>Tu opinión es la siguiente prueba.</h2>
          </div>
          <p>Tu evaluación nos ayuda a estudiar qué tan relevantes resultan las recomendaciones para personas reales. Es ciega: no sabrás qué sistema propuso cada pueblo. Participantes hasta ahora: <b id="human-count">—</b></p>
        </div>
        <div class="lab-shell" id="lab-panel">
          <p class="lab-counter" id="lab-counter" role="status">Cargando…</p>
          <div id="lab-stage"></div>
          <details class="lab-team">
            <summary>Resultados del laboratorio (equipo)</summary>
            <div id="lab-report" aria-live="polite"></div>
          </details>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="shell footer-inner">
      <a class="brand" href="#top"><span class="brand-mark"><i></i></span><span>ÓRBITA</span></a>
      <p>{m.corpus.towns} Pueblos Mágicos · {m.corpus.reviews.toLocaleString("es-MX")} reseñas · Rest-Mex 2025</p>
      <a href="#resultados">Metodología</a>
    </div>
  </footer>

  <script>
    import {
      basinMarkup,
      bottomMultiverseMarkup,
      branchMarkup,
      decisionTrailMarkup,
      rankingShiftMarkup,
      trajectoryMarkup,
    } from "../scripts/multiverse-markup";
    import cardMarkup from "../scripts/card-markup";
    import { escapeHtml, friendlyError, postJson, renderClassic, type RecommendResult } from "../scripts/classic";
    import { renderEvaluation } from "../scripts/evaluator";
    import { setupLab } from "../scripts/lab";

    import { API as API_URL } from "../scripts/api";

    const video = document.querySelector<HTMLVideoElement>("#explainer")!;
    const videoLayout = document.querySelector<HTMLElement>("#video-layout")!;
    document.querySelectorAll<HTMLButtonElement>(".video-tabs button").forEach((tab, _, tabs) =>
      tab.addEventListener("click", () => {
        if (tab.getAttribute("aria-selected") === "true") return;
        tabs.forEach((b) => b.setAttribute("aria-selected", String(b === tab)));
        video.poster = tab.dataset.poster!;
        video.src = tab.dataset.src!;
        videoLayout.classList.toggle("short", tab.dataset.src!.includes("2min"));
      }));
    const chapterButtons = [...document.querySelectorAll<HTMLButtonElement>("#chapters button")];
    chapterButtons.forEach((button) => button.addEventListener("click", () => {
      video.currentTime = Number(button.dataset.t);
      video.play().catch(() => {});
    }));
    video.addEventListener("timeupdate", () => {
      const t = video.currentTime;
      chapterButtons.forEach((b) => b.classList.toggle("active", t >= Number(b.dataset.t) && t < Number(b.dataset.end)));
    });
    const form = document.querySelector<HTMLFormElement>("#query-form")!;
    const query = document.querySelector<HTMLTextAreaElement>("#query")!;
    const risk = document.querySelector<HTMLInputElement>("#risk")!;
    const riskOutput = document.querySelector<HTMLOutputElement>("#risk-output")!;
    const apiStatus = document.querySelector<HTMLElement>("#api-status")!;
    const loading = document.querySelector<HTMLElement>("#loading")!;
    const results = document.querySelector<HTMLElement>("#results")!;
    const errorPanel = document.querySelector<HTMLElement>("#error")!;
    const errorMessage = document.querySelector<HTMLElement>("#error-message")!;
    const facets = document.querySelector<HTMLElement>("#facets")!;
    const chamber = document.querySelector<HTMLElement>("#multiverse-chamber")!;
    const canvas = document.querySelector<HTMLCanvasElement>("#multiverse-canvas")!;
    const basinGrid = document.querySelector<HTMLElement>("#basin-grid")!;
    const portalLegend = document.querySelector<HTMLElement>("#portal-legend")!;
    const sacrificeQuestion = document.querySelector<HTMLElement>("#sacrifice-question")!;
    const sacrificeActions = document.querySelector<HTMLElement>("#sacrifice-actions")!;
    const decisionTrail = document.querySelector<HTMLElement>("#decision-trail")!;
    const trajectoryLine = document.querySelector<HTMLElement>("#trajectory-line")!;
    const flash = document.querySelector<HTMLElement>("#collapse-flash")!;
    const colors = ["#78f0ce", "#f3c969", "#ff826b", "#8db6ff", "#d89cff"];
    let activeChoices: Array<{ keep: string; sacrifice: string }> = [];
    let currentData: any = null;
    let animationFrame = 0;

    const sparkContainer = document.querySelector<HTMLElement>("#hero-sparks")!;
    sparkContainer.innerHTML = Array.from({ length: 42 }, (_, index) =>
      `<i style="--i:${index};--d:${(index % 7) * -0.23}s"></i>`
    ).join("");

    risk.addEventListener("input", () => {
      riskOutput.value = `${risk.value}%`;
      risk.style.background = `linear-gradient(90deg, #216d61 ${risk.value}%, #c8d5d0 ${risk.value}%)`;
    });

    document.querySelectorAll<HTMLButtonElement>("[data-query]").forEach((button) => {
      button.addEventListener("click", () => {
        query.value = button.dataset.query ?? "";
        query.focus();
      });
    });

    async function checkApi() {
      try {
        const response = await fetch(`${API_URL}/health`);
        if (!response.ok) throw new Error();
        const health = await response.json();
        apiStatus.textContent = `MOTOR ${String(health.mode).toUpperCase()} / EN LÍNEA`;
        apiStatus.title = `Semántica: ${health.semantic_status}`;
        apiStatus.classList.add("online");
      } catch {
        apiStatus.textContent = "MOTOR SIN CONEXIÓN · inicia la API con make web-api";
        apiStatus.classList.add("offline");
      }
    }

    function countTo(element: HTMLElement, value: number, suffix = "") {
      const start = performance.now();
      const duration = 700;
      const frame = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        element.textContent = `${Math.round(value * eased).toLocaleString("es-MX")}${suffix}`;
        if (progress < 1) requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }

    function drawMultiverse(data: any) {
      cancelAnimationFrame(animationFrame);
      const context = canvas.getContext("2d")!;
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const bounds = chamber.getBoundingClientRect();
      canvas.width = Math.max(600, bounds.width * ratio);
      canvas.height = Math.max(430, bounds.height * ratio);
      context.scale(ratio, ratio);
      const width = canvas.width / ratio;
      const height = canvas.height / ratio;
      const portals = data.destinations.map((_: any, index: number) => {
        const angle = -Math.PI / 2 + index * (Math.PI * 2 / data.destinations.length);
        const radius = Math.min(width, height) * 0.32;
        return {
          x: width / 2 + Math.cos(angle) * radius,
          y: height / 2 + Math.sin(angle) * radius,
          color: colors[index],
          label: `${data.destinations[index].name} · ${data.destinations[index].share.toFixed(1)}%`,
        };
      });
      const shares = data.destinations.map((destination: any) => destination.share);
      const particles = Array.from({ length: 520 }, (_, index) => {
        const selector = (index * 73.137) % 100;
        let accumulated = 0;
        let destination = 0;
        for (let i = 0; i < shares.length; i += 1) {
          accumulated += shares[i];
          if (selector <= accumulated) { destination = i; break; }
        }
        return {
          destination,
          angle: index * 2.39996,
          radius: 16 + (index % 31) * 3.1,
          speed: .0015 + (index % 9) * .00017,
          size: 1 + (index % 4) * .45,
          phase: (index % 17) * .31,
        };
      });
      const start = performance.now();
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const animate = (time: number) => {
        const elapsed = time - start;
        context.clearRect(0, 0, width, height);
        const glow = context.createRadialGradient(width / 2, height / 2, 0, width / 2, height / 2, width * .4);
        glow.addColorStop(0, "rgba(95, 221, 193, .09)");
        glow.addColorStop(1, "rgba(4, 17, 28, 0)");
        context.fillStyle = glow;
        context.fillRect(0, 0, width, height);
        portals.forEach((portal: any, index: number) => {
          const pulse = 23 + Math.sin(elapsed * .003 + index) * 4;
          context.beginPath();
          context.arc(portal.x, portal.y, pulse, 0, Math.PI * 2);
          context.strokeStyle = `${portal.color}aa`;
          context.lineWidth = 2;
          context.stroke();
          context.beginPath();
          context.arc(portal.x, portal.y, pulse + 7, elapsed * .001, elapsed * .001 + Math.PI * 1.45);
          context.strokeStyle = `${portal.color}55`;
          context.lineWidth = 1;
          context.stroke();
          context.font = "600 12px ui-sans-serif, system-ui, sans-serif";
          context.textAlign = "center";
          context.fillStyle = "#d9ebe7";
          context.fillText(portal.label, portal.x, portal.y + (portal.y > height / 2 ? 50 : -38));
        });
        particles.forEach((particle: any) => {
          const portal = portals[particle.destination] || portals[0];
          const progress = .58 + .42 * Math.sin(elapsed * particle.speed + particle.phase);
          const spiral = particle.angle + elapsed * particle.speed * 2.3;
          const localRadius = particle.radius * (1 - progress * .78);
          const x = width / 2 + (portal.x - width / 2) * progress + Math.cos(spiral) * localRadius;
          const y = height / 2 + (portal.y - height / 2) * progress + Math.sin(spiral) * localRadius;
          context.beginPath();
          context.arc(x, y, particle.size, 0, Math.PI * 2);
          context.fillStyle = `${portal.color}${progress > .88 ? "ff" : "99"}`;
          context.fill();
        });
        if (!reduceMotion) animationFrame = requestAnimationFrame(animate);
      };
      if (reduceMotion) animate(0);
      else animationFrame = requestAnimationFrame(animate);
    }

    function renderData(data: any, collapsing = false) {
      const previous = currentData;
      currentData = data;
      const shiftPanel = document.querySelector<HTMLElement>("#shift-panel")!;
      if (collapsing && previous) {
        document.querySelector("#shift-list")!.innerHTML = rankingShiftMarkup(previous.destinations, data.destinations);
        shiftPanel.hidden = false;
      } else {
        shiftPanel.hidden = true;
      }
      const mc = data.monte_carlo;
      document.querySelector("#mc-note")!.textContent =
        `Monte Carlo: error estándar máximo ${mc.worst_case_se_pp} pp con ${data.surviving_futures.toLocaleString("es-MX")} futuros; ` +
        `con ${mc.convergence[0].futures.toLocaleString("es-MX")} los porcentajes se moverían hasta ${mc.convergence[0].max_abs_share_diff_vs_full_pp} pp. ${mc.note}`;
      document.querySelector("#bottom-multiverse")!.innerHTML = bottomMultiverseMarkup(data.bottom_in_multiverse);
      const leader = data.destinations[0]?.name ?? "—";
      document.querySelector("#top-destination")!.textContent = leader;
      const change = document.querySelector<HTMLElement>("#change-value")!;
      if (collapsing && previous && data.choices.length) {
        const before = previous.destinations[0]?.name;
        change.textContent = before === leader ? `Se mantiene ${leader}` : `${before} → ${leader}`;
        change.classList.toggle("changed", before !== leader);
      } else {
        change.textContent = "Responde una pregunta";
        change.classList.remove("changed");
      }
      countTo(document.querySelector("#total-futures")!, data.total_futures);
      countTo(document.querySelector("#surviving-futures")!, data.surviving_futures);
      countTo(document.querySelector("#collapsed-futures")!, data.collapsed_futures);
      countTo(document.querySelector("#entropy-value")!, data.decision_entropy, "%");
      facets.innerHTML = data.facets.map((facet: any) =>
        `<span>${escapeHtml(facet.label)}<b>${facet.weight}%</b></span>`
      ).join("");
      basinGrid.innerHTML = data.destinations.map(basinMarkup).join("");
      portalLegend.innerHTML = data.destinations.map((destination: any, index: number) =>
        `<span style="--portal-color:${colors[index]}"><i></i>${escapeHtml(destination.name)} <b>${destination.share}%</b></span>`
      ).join("");
      trajectoryLine.innerHTML = data.trajectory.map(trajectoryMarkup).join("");
      decisionTrail.innerHTML = decisionTrailMarkup(data.choices);
      document.querySelector("#simulation-disclaimer")!.textContent = data.disclaimer;

      if (data.question) {
        sacrificeQuestion.textContent = "Si tuvieras que priorizar una experiencia, ¿cuál conservarías?";
        document.querySelector("#information-gain")!.textContent =
          `Pregunta elegida por ganancia de información: reduce la entropía en ${data.question.information_gain.toFixed(2)} puntos en promedio.`;
        sacrificeActions.innerHTML = data.question.branches.map(branchMarkup).join("");
      } else {
        sacrificeQuestion.textContent = data.facets.length < 2
          ? "Reconocimos una sola preferencia: no hay nada que priorizar."
          : "Tus escenarios ya apuntan con claridad a un resultado.";
        document.querySelector("#information-gain")!.textContent =
          "No queda una pregunta capaz de dividir los escenarios de forma útil.";
        sacrificeActions.innerHTML = "";
      }

      sacrificeActions.querySelectorAll<HTMLButtonElement>("[data-keep]").forEach((button) => {
        button.addEventListener("click", () => collapseFuture({
          keep: button.dataset.keep!,
          sacrifice: button.dataset.sacrifice!,
        }));
      });
      if (collapsing) {
        flash.classList.remove("active");
        void flash.offsetWidth;
        flash.classList.add("active");
      }
      drawMultiverse(data);
    }

    const loopError = document.querySelector<HTMLElement>("#loop-error")!;
    async function simulate(collapsing = false) {
      loopError.hidden = true;
      if (!collapsing) results.hidden = true;
      try {
        const response = await fetch(`${API_URL}/api/multiverse`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            query: query.value,
            risk: Number(risk.value) / 100,
            futures: 50000,
            choices: activeChoices,
          }),
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "El motor rechazó la consulta.");
        document.querySelector<HTMLElement>("#loop-empty")!.hidden = true;
        results.hidden = false;
        renderData(data, collapsing);
      } catch (error) {
        document.querySelector("#loop-error-message")!.textContent = friendlyError(error);
        loopError.hidden = false;
      }
    }

    const orbitResults = document.querySelector<HTMLElement>("#orbit-results")!;
    const roleIcon: Record<string, string> = { Ancla: "◎", Superviviente: "◆", Portal: "◐", Especialista: "▲", Comodín: "✦" };
    async function loadOrbit() {
      errorPanel.hidden = true;
      orbitResults.hidden = true;
      loading.hidden = false;
      try {
        const response = await fetch(`${API_URL}/api/futures`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ query: query.value, risk: Number(risk.value) / 100 }),
        });
        const orbit = await response.json();
        if (!response.ok) throw new Error(orbit.error);
        document.querySelector("#orbit-atoms")!.innerHTML = orbit.facets.map((f: any) =>
          `<span class="atom"><i aria-hidden="true"></i>${escapeHtml(f.label)}</span>`).join("") +
          (orbit.excluded_concepts ? `<span class="atom excluded"><i aria-hidden="true">⊘</i>Sin ${escapeHtml(orbit.excluded_concepts)}</span>` : "");
        const note = document.querySelector<HTMLElement>("#orbit-note")!;
        const filled = orbit.method?.roles_filled ?? orbit.destinations.length;
        note.hidden = filled >= 5;
        note.textContent = `Solo ${filled} destinos cumplen tus exclusiones y son distintos entre sí: mostramos ${filled} perspectivas en lugar de cinco.`;
        document.querySelector("#orbit-grid")!.innerHTML = orbit.destinations
          .map((d: any, i: number) => cardMarkup({ ...d, icon: roleIcon[d.role] }, i)).join("");
        document.querySelector("#bottom-orbit")!.innerHTML = orbit.bottom_perspective.map((b: any) =>
          `<li><b>#${b.global_rank} ${escapeHtml(b.name)}</b> <span>${escapeHtml(b.verdict)}</span></li>`).join("");
        orbitResults.hidden = false;
        orbitResults.scrollIntoView({ behavior: "smooth", block: "start" });
      } catch (error) {
        const message = friendlyError(error);
        document.querySelector("#error-title")!.textContent = message.startsWith("Encontramos")
          ? "Revisa tu descripción." : "No pudimos completar la exploración.";
        errorMessage.textContent = message;
        errorPanel.hidden = false;
      } finally {
        loading.hidden = true;
      }
    }

    async function collapseFuture(choice: { keep: string; sacrifice: string }) {
      activeChoices.push(choice);
      document.querySelector("#particle-caption")!.textContent =
        `Conservas ${choice.keep}: descartando los escenarios que priorizan ${choice.sacrifice}…`;
      chamber.classList.add("collapsing");
      await simulate(true);
      chamber.classList.remove("collapsing");
      document.querySelector("#particle-caption")!.textContent = "Cada luz es una forma posible de priorizar tus gustos";
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      activeChoices = [];
      await Promise.all([loadOrbit(), simulate(false)]);
    });

    document.querySelector("#reset-loop")!.addEventListener("click", async () => {
      activeChoices = [];
      await simulate(true);
    });

    window.addEventListener("resize", () => {
      if (currentData && !results.hidden) drawMultiverse(currentData);
    });

    const classicForm = document.querySelector<HTMLFormElement>("#classic-form")!;
    const classicQuery = document.querySelector<HTMLTextAreaElement>("#classic-query")!;
    const classicResults = document.querySelector<HTMLElement>("#classic-results")!;
    const classicStatus = document.querySelector<HTMLElement>("#classic-status")!;
    async function recommend() {
      classicStatus.textContent = "CALCULANDO…";
      classicResults.setAttribute("aria-busy", "true");
      try {
        const data = await postJson<RecommendResult>("/api/recommend", { query: classicQuery.value });
        classicResults.innerHTML = renderClassic(data);
        classicStatus.textContent = data.mode.toUpperCase();
      } catch (error) {
        classicResults.innerHTML = `<div class="error-panel" role="alert"><strong>No pudimos recomendar todavía.</strong><p></p></div>`;
        classicResults.querySelector("p")!.textContent = friendlyError(error);
        classicStatus.textContent = "ERROR";
      } finally {
        classicResults.removeAttribute("aria-busy");
      }
    }
    classicForm.addEventListener("submit", (event) => { event.preventDefault(); recommend(); });
    document.querySelectorAll<HTMLButtonElement>("[data-classic]").forEach((button) => {
      button.addEventListener("click", () => { classicQuery.value = button.dataset.classic ?? ""; recommend(); });
    });

    const evalOutput = document.querySelector<HTMLElement>("#eval-output")!;
    const evalButtons = document.querySelectorAll<HTMLButtonElement>("#eval-run, #eval-last");
    async function showEvaluation(run: boolean) {
      evalButtons.forEach((button) => { button.disabled = true; });
      evalOutput.innerHTML = `<p class="eval-meta">${run ? "Ejecutando el banco de consultas…" : "Cargando reporte…"}</p>`;
      try {
        const report = run ? await postJson<any>("/api/evaluation/run", {}) : await (async () => {
          const response = await fetch(`${API_URL}/api/evaluation`);
          const data = await response.json();
          if (!response.ok) throw new Error(data.error);
          return data;
        })();
        evalOutput.innerHTML = renderEvaluation(report);
      } catch (error) {
        evalOutput.innerHTML = `<div class="error-panel" role="alert"><p></p></div>`;
        evalOutput.querySelector("p")!.textContent = error instanceof Error ? error.message : "Error desconocido.";
      } finally {
        evalButtons.forEach((button) => { button.disabled = false; });
      }
    }
    document.querySelector("#eval-run")!.addEventListener("click", () => showEvaluation(true));
    document.querySelector("#eval-last")!.addEventListener("click", () => showEvaluation(false));
    setupLab(document.querySelector<HTMLElement>("#lab-panel")!);

    checkApi();
  </script>
</BaseLayout>
